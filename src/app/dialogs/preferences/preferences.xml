<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <template class="PreferencesDialog" parent="AdwPreferencesDialog">
        <property name="title">Preferences</property>

        <child>
            <object class="AdwPreferencesPage">
                <child>
                    <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Interface</property>

                        <child>
                            <object class="AdwSwitchRow" id="remember_window_state">
                                <property name="title" translatable="yes">Remember window state</property>
                                <property name="subtitle" translatable="yes">Save and restore window dimensions, maximized and fullscreen state</property>

                                <signal name="notify::active" handler="on_remember_window_state_changed" swapped="true"/>
                            </object>
                        </child>

                        <child>
                            <object class="AdwSwitchRow" id="no_window_decorations">
                                <property name="title" translatable="yes">Remove window decorations</property>
                                <property name="subtitle" translatable="yes">Removes title bar, rounded corners and drop shadow</property>

                                <signal name="notify::active" handler="on_no_window_decorations_changed" swapped="true"/>
                            </object>
                        </child>

                        <child>
                            <object class="AdwSwitchRow" id="kde_theme">
                                <property name="title" translatable="yes">KDE Theme</property>
                                <property name="subtitle" translatable="yes">Requires restarting the application for changes to take effect</property>

                                <signal name="notify::active" handler="on_kde_theme_changed" swapped="true"/>
                            </object>
                        </child>
                    </object>
                </child>

                <child>
                    <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">MPV</property>

                       <child>
                            <object class="AdwEntryRow" id="mpv_config_location">
                                <property name="title" translatable="yes">Configuration file location</property>

                                <signal name="changed" handler="on_mpv_config_location_changed" swapped="true"/>

                                <child>
                                    <object class="GtkButton">
                                        <property name="valign">center</property>
                                        <property name="icon_name">document-open-symbolic</property>

                                        <style>
                                            <class name="flat"/>
                                        </style>

                                        <signal name="clicked" handler="browse_mpv_config_file" swapped="true"/>
                                    </object>
                                </child>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
    </template>
</interface>